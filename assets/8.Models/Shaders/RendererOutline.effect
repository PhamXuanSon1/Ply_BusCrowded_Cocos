CCEffect %{
  techniques:
  - name: default
    passes:
    - vert: spriteRender-vs:vert
      frag: spriteRender-fs:frag
      depthStencilState:
        depthTest: true
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        mainColor: {value: [1, 1, 1, 1], editor: {type: color}}
        outline: {value: [1, 1, 1, 1], editor: {type: color}}
        useOutline: {value: 0}
        outlineWidth: {value: 1.0}
}%

CCProgram spriteRender-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #include <builtin/uniforms/cc-local>

  in vec3 a_position;
  in vec2 a_texCoord;

  out vec2 uv0;

  vec4 vert () {
    vec4 pos = vec4(a_position, 1);

    pos = cc_matViewProj * cc_matWorld * pos;

    uv0 = vec2(a_texCoord.x, 1.0 - a_texCoord.y);

    return pos;
  }
}%

CCProgram spriteRender-fs %{
  precision highp float;

  uniform Constants {
    vec4 mainColor;
    vec4 outline;
    float outlineWidth;
    float useOutline;
  };

  in vec2 uv0;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;

  vec4 frag () {
    vec4 o = vec4(1, 1, 1, 1);


    o *= texture(cc_spriteTexture, uv0);
    o *= mainColor;

    if(o.a < 0.8) discard;

    if(useOutline > 0.0)  {
    o.xyz = mainColor.xyz;
    
    vec2 arounds[8];
    arounds[0] = vec2(-1, -1);
    arounds[1] = vec2(0, -1);
    arounds[2] = vec2(1, -1);
    arounds[3] = vec2(-1, 0);
    arounds[4] = vec2(1, 0);
    arounds[5] = vec2(-1, 1);
    arounds[6] = vec2(0, 1);
    arounds[7] = vec2(1, 1);
    for(int i = 0; i < 8; i++){
      vec2 uv = uv0 + arounds[i] * outlineWidth;
      vec4 texColor = texture(cc_spriteTexture, uv);
      if(texColor.a < 1.0){
        o.xyz = outline.xyz;
        o.a = outline.a;
        break;
      }
    }
    }


    return o;
  }
}%
